#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../versions.env
source "$ROOT/versions.env"

SANDBOX_HOME="${CHAIN_SANDBOX_HOME:-$HOME/.cache/chain-sandbox}"
TOOLS_DIR="$SANDBOX_HOME/tools"
STATE_DIR="$SANDBOX_HOME/state"
LOG_DIR="$SANDBOX_HOME/logs"
mkdir -p "$TOOLS_DIR" "$STATE_DIR" "$LOG_DIR"

BITCOIN_PORT="${CHAIN_SANDBOX_BITCOIN_PORT:-18443}"
ETHEREUM_PORT="${CHAIN_SANDBOX_ETHEREUM_PORT:-8545}"
SOLANA_PORT="${CHAIN_SANDBOX_SOLANA_PORT:-8899}"
SOLANA_FAUCET_PORT="${CHAIN_SANDBOX_SOLANA_FAUCET_PORT:-9900}"

usage() {
  cat <<'EOF'
Usage: chain-sandbox <start|health|self-test|stop> <bitcoin|ethereum|solana|all>
EOF
}

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "chain-sandbox: missing required command: $1" >&2
    exit 1
  }
}

wait_until() {
  local attempts="$1"
  shift
  local i
  for ((i = 0; i < attempts; i++)); do
    if "$@" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
  done
  return 1
}

emit_endpoint() {
  local env_name="$1"
  local output_name="$2"
  local value="$3"

  printf '%s=%s\n' "$env_name" "$value"
  if [[ -n "${GITHUB_ENV:-}" ]]; then
    printf '%s=%s\n' "$env_name" "$value" >>"$GITHUB_ENV"
  fi
  if [[ -n "${GITHUB_OUTPUT:-}" ]]; then
    printf 'rpc-url=%s\n' "$value" >>"$GITHUB_OUTPUT"
    printf '%s=%s\n' "$output_name" "$value" >>"$GITHUB_OUTPUT"
  fi
}

bitcoin_rpc() {
  curl --fail --silent --show-error \
    --user chain:sandbox \
    --header 'content-type: text/plain;' \
    --data-binary "${1}" \
    "http://127.0.0.1:${BITCOIN_PORT}/"
}

ethereum_rpc() {
  curl --fail --silent --show-error \
    --header 'content-type: application/json' \
    --data-binary "${1}" \
    "http://127.0.0.1:${ETHEREUM_PORT}"
}

solana_rpc() {
  curl --fail --silent --show-error \
    --header 'content-type: application/json' \
    --data-binary "${1}" \
    "http://127.0.0.1:${SOLANA_PORT}"
}

stop_bitcoin() {
  if command -v docker >/dev/null 2>&1; then
    docker rm -f chain-sandbox-bitcoin >/dev/null 2>&1 || true
  fi
}

start_bitcoin() {
  need docker
  need curl
  stop_bitcoin

  docker run --detach --rm \
    --name chain-sandbox-bitcoin \
    --publish "127.0.0.1:${BITCOIN_PORT}:18443" \
    "$BITCOIN_IMAGE" \
    -printtoconsole \
    -regtest=1 \
    -server=1 \
    -rpcbind=0.0.0.0 \
    -rpcallowip=0.0.0.0/0 \
    -rpcuser=chain \
    -rpcpassword=sandbox \
    -fallbackfee=0.0002 >/dev/null

  if ! wait_until 60 bitcoin_rpc '{"jsonrpc":"1.0","id":"health","method":"getblockchaininfo","params":[]}'; then
    docker logs chain-sandbox-bitcoin >&2 || true
    return 1
  fi

  docker exec chain-sandbox-bitcoin \
    bitcoin-cli -regtest -rpcuser=chain -rpcpassword=sandbox \
    createwallet sandbox >/dev/null
  local address
  address="$(docker exec chain-sandbox-bitcoin \
    bitcoin-cli -regtest -rpcuser=chain -rpcpassword=sandbox -rpcwallet=sandbox \
    getnewaddress)"
  docker exec chain-sandbox-bitcoin \
    bitcoin-cli -regtest -rpcuser=chain -rpcpassword=sandbox -rpcwallet=sandbox \
    generatetoaddress 101 "$address" >/dev/null

  emit_endpoint BITCOIN_RPC_URL bitcoin-rpc-url \
    "http://chain:sandbox@127.0.0.1:${BITCOIN_PORT}"
}

health_bitcoin() {
  bitcoin_rpc '{"jsonrpc":"1.0","id":"health","method":"getblockchaininfo","params":[]}' \
    | grep -q '"chain":"regtest"'
}

self_test_bitcoin() {
  health_bitcoin
  local blocks
  blocks="$(docker exec chain-sandbox-bitcoin \
    bitcoin-cli -regtest -rpcuser=chain -rpcpassword=sandbox getblockcount)"
  [[ "$blocks" -ge 101 ]]
  docker exec chain-sandbox-bitcoin \
    bitcoin-cli -regtest -rpcuser=chain -rpcpassword=sandbox -rpcwallet=sandbox \
    getbalance >/dev/null
}

stop_ethereum() {
  if command -v docker >/dev/null 2>&1; then
    docker rm -f chain-sandbox-ethereum >/dev/null 2>&1 || true
  fi
}

start_ethereum() {
  need docker
  need curl
  stop_ethereum

  docker run --detach --rm \
    --name chain-sandbox-ethereum \
    --publish "127.0.0.1:${ETHEREUM_PORT}:8545" \
    --entrypoint anvil \
    "$FOUNDRY_IMAGE" \
    --host 0.0.0.0 \
    --port 8545 \
    --chain-id 31337 \
    --accounts 10 \
    --balance 10000 >/dev/null

  if ! wait_until 60 ethereum_rpc '{"jsonrpc":"2.0","id":1,"method":"eth_chainId","params":[]}'; then
    docker logs chain-sandbox-ethereum >&2 || true
    return 1
  fi

  emit_endpoint ETHEREUM_RPC_URL ethereum-rpc-url \
    "http://127.0.0.1:${ETHEREUM_PORT}"
}

health_ethereum() {
  ethereum_rpc '{"jsonrpc":"2.0","id":1,"method":"eth_chainId","params":[]}' \
    | grep -qi '0x7a69'
}

self_test_ethereum() {
  health_ethereum
  ethereum_rpc '{"jsonrpc":"2.0","id":2,"method":"eth_blockNumber","params":[]}' \
    | grep -q '"result"'
  ethereum_rpc '{"jsonrpc":"2.0","id":3,"method":"eth_accounts","params":[]}' \
    | grep -q '0x'
}

agave_dir() {
  printf '%s/agave-%s' "$TOOLS_DIR" "$AGAVE_VERSION"
}

install_agave() {
  need curl
  need sha256sum
  need tar

  if [[ "$(uname -s)" != "Linux" || "$(uname -m)" != "x86_64" ]]; then
    echo "chain-sandbox: bundled Agave installer currently supports Linux x86_64" >&2
    exit 1
  fi

  local destination archive url
  destination="$(agave_dir)"
  if [[ -x "$destination/bin/solana-test-validator" ]]; then
    return 0
  fi

  archive="$TOOLS_DIR/solana-release-${AGAVE_VERSION}-x86_64-unknown-linux-gnu.tar.bz2"
  url="https://github.com/anza-xyz/agave/releases/download/v${AGAVE_VERSION}/solana-release-x86_64-unknown-linux-gnu.tar.bz2"

  if [[ ! -f "$archive" ]]; then
    curl --fail --location --retry 4 --retry-delay 2 --output "$archive" "$url"
  fi

  printf '%s  %s\n' "$AGAVE_LINUX_X86_64_SHA256" "$archive" | sha256sum --check --status

  rm -rf "$destination"
  mkdir -p "$destination"
  tar -xjf "$archive" -C "$destination" --strip-components=1
  [[ -x "$destination/bin/solana-test-validator" ]]
}

solana_pid_file() {
  printf '%s/solana.pid' "$STATE_DIR"
}

stop_solana() {
  local pid_file pid
  pid_file="$(solana_pid_file)"
  if [[ -f "$pid_file" ]]; then
    pid="$(cat "$pid_file")"
    if kill -0 "$pid" >/dev/null 2>&1; then
      kill "$pid" >/dev/null 2>&1 || true
      for _ in {1..10}; do
        kill -0 "$pid" >/dev/null 2>&1 || break
        sleep 1
      done
      kill -9 "$pid" >/dev/null 2>&1 || true
    fi
    rm -f "$pid_file"
  fi
}

start_solana() {
  need curl
  install_agave
  stop_solana

  local validator ledger log pid_file
  validator="$(agave_dir)/bin/solana-test-validator"
  ledger="$STATE_DIR/solana-ledger"
  log="$LOG_DIR/solana.log"
  pid_file="$(solana_pid_file)"
  rm -rf "$ledger"

  "$validator" \
    --reset \
    --ledger "$ledger" \
    --rpc-port "$SOLANA_PORT" \
    --faucet-port "$SOLANA_FAUCET_PORT" \
    --quiet >"$log" 2>&1 &
  echo "$!" >"$pid_file"

  if ! wait_until 90 solana_rpc '{"jsonrpc":"2.0","id":1,"method":"getHealth"}'; then
    cat "$log" >&2 || true
    return 1
  fi

  emit_endpoint SOLANA_RPC_URL solana-rpc-url \
    "http://127.0.0.1:${SOLANA_PORT}"
}

health_solana() {
  solana_rpc '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' \
    | grep -q '"ok"'
}

self_test_solana() {
  health_solana
  solana_rpc '{"jsonrpc":"2.0","id":2,"method":"getLatestBlockhash"}' \
    | grep -q 'blockhash'
}

start_chain() {
  case "$1" in
    bitcoin) start_bitcoin ;;
    ethereum) start_ethereum ;;
    solana) start_solana ;;
    *) usage; exit 2 ;;
  esac
}

health_chain() {
  case "$1" in
    bitcoin) health_bitcoin ;;
    ethereum) health_ethereum ;;
    solana) health_solana ;;
    *) usage; exit 2 ;;
  esac
}

self_test_chain() {
  case "$1" in
    bitcoin) self_test_bitcoin ;;
    ethereum) self_test_ethereum ;;
    solana) self_test_solana ;;
    *) usage; exit 2 ;;
  esac
}

stop_chain() {
  case "$1" in
    bitcoin) stop_bitcoin ;;
    ethereum) stop_ethereum ;;
    solana) stop_solana ;;
    all)
      stop_bitcoin
      stop_ethereum
      stop_solana
      ;;
    *) usage; exit 2 ;;
  esac
}

main() {
  [[ $# -eq 2 ]] || {
    usage
    exit 2
  }

  case "$1" in
    start) start_chain "$2" ;;
    health) health_chain "$2" ;;
    self-test) self_test_chain "$2" ;;
    stop) stop_chain "$2" ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
